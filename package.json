{
  "name": "tezinvaders",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:test": "contract/scripts/test-mockup.sh",
    "contract:deploy": "contract/scripts/deploy.sh",
    "deploy:aws": "deploy/aws-deploy.sh",
    "verifier": "node verifier/server.ts",
    "verifier:keygen": "node verifier/keygen.ts",
    "verifier:bundle": "rolldown verifier/lambda.ts --format esm --platform node --external @aws-sdk/client-secrets-manager --file verifier/dist/lambda.mjs",
    "contract:deploy-network": "contract/scripts/deploy-network.sh"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1165.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tezos-x/octez.connect-sdk": "^5.0.4",
    "@tezos-x/octez.js": "^25.0.0",
    "@tezos-x/octez.js-dapp-wallet": "^25.0.0",
    "buffer": "^6.0.3"
  }
}
