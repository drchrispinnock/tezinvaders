# Copy to .env and fill in after deploying the contract (see contract/scripts/deploy.sh).
# The panel has Shadownet / Mainnet and L1 / L2 toggles (Shadownet L1 by default); each of the
# four combinations has its own contract. L2 is Tezos X, the Etherlink rollup's Michelson
# interface. Leave an address empty and that network is free play only.
VITE_RPC_URL_SHADOWNET=https://rpc.shadownet.teztnets.com
VITE_CONTRACT_ADDRESS_SHADOWNET=
VITE_RPC_URL_MAINNET=https://rpc.tzkt.io/mainnet
VITE_CONTRACT_ADDRESS_MAINNET=
VITE_RPC_URL_TEZOSX_SHADOWNET=https://michelson.etherlink.shadownet.octez.io
VITE_CONTRACT_ADDRESS_TEZOSX_SHADOWNET=
VITE_RPC_URL_TEZOSX_MAINNET=https://michelson.etherlink.mainnet.octez.io
VITE_CONTRACT_ADDRESS_TEZOSX_MAINNET=

# The score verifier (verifier/server.ts or lambda.ts); one for every network. Empty: scores cannot be submitted.
VITE_VERIFIER_URL=
