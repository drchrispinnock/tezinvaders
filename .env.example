# Copy to .env. Networks, RPCs and contract addresses live in src/chain/networks.json (the URL
# picks the network: /shadownet, /shadownet/tezosx, /mainnet, …). A contract address can be
# overridden here for local work with VITE_CONTRACT_ADDRESS_<NAME>, e.g.
# VITE_CONTRACT_ADDRESS_SHADOWNET=KT1… or VITE_CONTRACT_ADDRESS_TEZOSX_SHADOWNET=KT1….

# The score verifier (verifier/server.ts or lambda.ts); one for every network. Empty: scores cannot be submitted.
VITE_VERIFIER_URL=http://localhost:8787
