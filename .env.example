# Copy to .env and fill in after deploying the contract (see contract/scripts/deploy.sh).
# The panel has a Shadownet / Mainnet toggle (Shadownet by default); each network has its own
# contract. Leave an address empty and that network is free play only.
VITE_RPC_URL_SHADOWNET=https://rpc.shadownet.teztnets.com
VITE_CONTRACT_ADDRESS_SHADOWNET=
VITE_RPC_URL_MAINNET=https://rpc.tzkt.io/mainnet
VITE_CONTRACT_ADDRESS_MAINNET=
