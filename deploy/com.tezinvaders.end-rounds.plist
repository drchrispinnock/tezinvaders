<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hourly end_round backstop. Install:
         cp deploy/com.tezinvaders.end-rounds.plist ~/Library/LaunchAgents/
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tezinvaders.end-rounds.plist
       Run now: launchctl kickstart -k gui/$(id -u)/com.tezinvaders.end-rounds
       Log: ~/Library/Logs/tezinvaders-end-rounds.log -->
  <key>Label</key><string>com.tezinvaders.end-rounds</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/chris/tezos/tezinvaders/deploy/end-rounds.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/chris/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>SIGNER</key><string>tezinvaders-admin</string>
  </dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/chris/Library/Logs/tezinvaders-end-rounds.log</string>
  <key>StandardErrorPath</key><string>/Users/chris/Library/Logs/tezinvaders-end-rounds.log</string>
</dict>
</plist>
